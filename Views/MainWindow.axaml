<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Barstocks.Views.MainWindow"
        Title="Barstocks"
        Width="1920" Height="45"
        Background="Transparent"
        SystemDecorations="None"
        Topmost="True"
        CanResize="False"
        TransparencyLevelHint="Transparent">

    <Border Name="MainBorder"
            Background="#01000000"
            BorderBrush="#33FFFFFF"
            BorderThickness="0,0,0,1"
            PointerPressed="MainBorder_PointerPressed">

        <Grid ColumnDefinitions="*, Auto, Auto">
            <Canvas Grid.Column="0" Name="MainCanvas" Background="Transparent" ClipToBounds="True">
                <TextBlock Name="TickerText" FontSize="18" Foreground="White" FontWeight="Bold"/>
            </Canvas>

            <Button Grid.Column="1" Name="ExpandButton" Content="🗖"
                    Click="ExpandButton_OnClick"
                    Background="Transparent" Foreground="#88FFFFFF" FontSize="16"
                    Opacity="0" Width="40"/>

            <Button Grid.Column="2" Name="SettingsButton" Content="⚙"
                    Click="SetFollowStocksButton_OnClick"
                    Background="Transparent" Foreground="#88FFFFFF" FontSize="20"
                    Opacity="0" Width="40"/>
        </Grid>
    </Border>
</Window>
